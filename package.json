{
  "name": "@alecliu/pi-zai-usage",
  "version": "0.1.6",
  "description": "pi extension: shows your real server-side quota for Zhipu GLM / Z.ai Coding Plan inline in the footer status bar (5h token window, weekly quota, tool quotas), with a local-session fallback estimate and a /usage detail command.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": {
    "name": "Alec",
    "url": "https://github.com/Alec01"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alec01/pi-zai-usage.git"
  },
  "bugs": {
    "url": "https://github.com/Alec01/pi-zai-usage/issues"
  },
  "homepage": "https://github.com/Alec01/pi-zai-usage#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
